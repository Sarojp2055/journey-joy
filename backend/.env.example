# =============================================
# BACKEND ENVIRONMENT VARIABLES
# Copy to .env and fill in your values
# =============================================

# Server Port (Vercel ignores this)
PORT=5000

# Database Connection (Aiven MySQL)
# Format: mysql://username:password@host:port/database?ssl-mode=REQUIRED
DATABASE_URL=mysql://user:password@host:port/dbname?ssl-mode=REQUIRED

# JWT Secret Key (Use a strong random string in production!)
JWT_SECRET=your_super_secret_jwt_key_here

# WhatsApp Number for contact
WHATSAPP_NUMBER=9779800000000

# Frontend URL (for CORS)
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Node Environment (set to 'production' on Vercel)
NODE_ENV=development

{
    "version": 2,
    "buildCommand": "npm run vercel-build",
    "outputDirectory": "frontend/dist",
    "functions": {
        "backend/api/index.js": {
            "runtime": "@vercel/node"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/backend/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}